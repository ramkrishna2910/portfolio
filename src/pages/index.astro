---
import BaseLayout from "../layouts/BaseLayout.astro";
import KineticGrid from "../components/KineticGrid.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { loadAll, fmtRange } from "../lib/content";

const c = await loadAll();
const p = c.profile;
const featured = c.projects.filter((pr) => pr.data.featured);

const logos: Record<string, string> = {
  AMD: "/logos/amd.svg",
  Groq: "/logos/groq.svg",
  Intel: "/logos/intel.svg",
};
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <KineticGrid />
    <div class="shell-wide hero-content">
      <p class="eyebrow">Seattle, WA · On-device AI</p>
      <h1>Ramakrishnan<br />Sivakumar</h1>
      <p class="headline">
        Principal ML Software Engineer at
        <a href="https://www.amd.com" rel="noopener">AMD</a>. I make large language models run
        fast on hardware people already own — as co-creator and maintainer of
        <a href="https://github.com/lemonade-sdk/lemonade" rel="noopener">Lemonade</a>, the
        open-source local AI server (5k+ stars).
      </p>
      <div class="hero-socials">
        <SocialLinks />
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="section" aria-labelledby="exp-h">
    <div class="shell-wide">
      <div class="section-head"><h2 id="exp-h" class="eyebrow">Experience</h2></div>
      <div class="exp-list">
        {
          c.experience.map((e) => (
            <article class="exp-row">
              <span class="logo-tile">
                <img src={logos[e.data.company]} alt="" loading="lazy" width="28" height="28" />
              </span>
              <div>
                <h3>
                  {e.data.title} ·{" "}
                  <a href={e.data.companyUrl} rel="noopener">
                    {e.data.company}
                  </a>
                </h3>
                <p class="meta">
                  {fmtRange(e.data.start, e.data.end)} · {e.data.location}
                </p>
              </div>
            </article>
          ))
        }
        <article class="exp-row">
          <span class="logo-tile">
            <img src="/logos/uncc.svg" alt="" loading="lazy" width="28" height="28" />
          </span>
          <div>
            <h3>
              MS, {c.education.field} ·{" "}
              <a href={c.education.institutionUrl} rel="noopener">UNC Charlotte</a>
            </h3>
            <p class="meta">
              {c.education.start.slice(0, 4)} — {c.education.end.slice(0, 4)} · Charlotte, NC
            </p>
          </div>
        </article>
      </div>
      <p class="more meta">
        Role details in <a rel="alternate" type="text/markdown" href="/resume.md">/resume.md</a>
      </p>
    </div>
  </section>

  <!-- Selected work -->
  <section class="section section--wash" aria-labelledby="work-h">
    <div class="shell-wide">
      <div class="section-head"><h2 id="work-h" class="eyebrow">Selected work</h2></div>
      <div class="work-grid">
        {
          featured.map((pr) => (
            <a class="work-card" href={pr.data.url} rel="noopener">
              <p class="meta">{pr.data.role}</p>
              <h3>{pr.data.name}</h3>
              <p class="tagline">{pr.data.tagline}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: var(--s16) var(--s12);
  }
  .hero + .section {
    border-top: none;
  }
  .hero-content {
    position: relative;
    z-index: 1;
  }
  .hero-content a {
    pointer-events: auto;
  }
  .hero h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    font-variation-settings: "wdth" 122;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin-block: var(--s4) var(--s6);
    color: var(--ink);
  }
  .headline {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    max-width: 34em;
  }
  .hero-socials {
    margin-top: var(--s8);
  }

  /* compact sections */
  .section {
    padding-block: var(--s12);
  }


  .exp-list {
    display: grid;
  }
  .exp-row {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: var(--s5);
    align-items: center;
    padding-block: var(--s5);
    border-bottom: 1px solid var(--rule);
  }
  .exp-row:last-child {
    border-bottom: none;
  }
  .logo-tile {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--rule);
    background: #fff;
  }
  .logo-tile img {
    width: 1.9rem;
    height: 1.9rem;
    object-fit: contain;
    filter: grayscale(1) opacity(0.65);
    transition: filter 120ms ease;
  }
  .exp-row:hover .logo-tile img {
    filter: none;
  }
  .exp-row h3 {
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .exp-row .meta {
    margin-top: var(--s1);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: var(--s4);
  }
  .work-card {
    display: grid;
    gap: var(--s2);
    align-content: start;
    border: 1px solid var(--rule);
    background: var(--bg);
    padding: var(--s6);
    text-decoration: none;
    transition: border-color 120ms ease;
  }
  .work-card:hover {
    border-color: var(--accent);
  }
  .work-card h3 {
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .work-card:hover h3 {
    color: var(--accent-ink);
  }
  .work-card .tagline {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
</style>
