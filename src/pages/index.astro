---
import BaseLayout from "../layouts/BaseLayout.astro";
import KineticGrid from "../components/KineticGrid.astro";
import { loadAll, fmtRange } from "../lib/content";

const c = await loadAll();
const p = c.profile;
const featured = c.projects.filter((pr) => pr.data.featured);
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <KineticGrid />
    <div class="shell-wide hero-content">
      <p class="eyebrow">Seattle, WA · On-device AI</p>
      <h1>Ramakrishnan<br />Sivakumar</h1>
      <p class="headline">
        Principal Engineer at <a href="https://www.amd.com" rel="noopener">AMD</a>, making large
        language models run fast on the hardware people already own. Maintainer of
        <a href="https://github.com/lemonade-sdk/lemonade" rel="noopener">Lemonade</a>, the
        open-source local AI server.
      </p>
      <p class="hero-machines" aria-label="Machine-readable versions of this site">
        <span class="meta">for agents&nbsp;→</span>
        <a rel="alternate" type="text/markdown" href="/resume.md">/resume.md</a>
        <a href="/llms.txt">/llms.txt</a>
      </p>
    </div>
  </section>

  <!-- About -->
  <section class="section" aria-labelledby="about-h">
    <div class="shell-wide">
      <div class="section-head"><h2 id="about-h" class="eyebrow">About</h2></div>
      <div class="about-grid">
        <div class="about-prose">
          <p>{p.longBio[0]}</p>
          <p class="more meta">
            <a rel="alternate" type="text/markdown" href="/resume.md">cat /resume.md</a> for the
            long version
          </p>
        </div>
        <aside class="facts" aria-label="At a glance">
          <p class="meta facts-title">At a glance</p>
          <dl>
            <div><dt>Role</dt><dd>Principal Engineer, AMD</dd></div>
            <div><dt>Focus</dt><dd>On-device AI · local LLMs</dd></div>
            <div><dt>Open source</dt><dd>Lemonade — 5.3k★</dd></div>
            <div><dt>Shipping since</dt><dd>2016 · Intel → Groq → AMD</dd></div>
            <div><dt>Patents</dt><dd>2 granted (US)</dd></div>
            <div><dt>Community</dt><dd>ONNX Model Zoo · meetup panels</dd></div>
            <div>
              <dt>Off hours</dt>
              <dd>
                {c.interests.map((i, idx) => (
                  <>
                    {i.data.url ? (
                      <a href={i.data.url} rel="noopener">
                        {i.data.label}
                      </a>
                    ) : (
                      i.data.label
                    )}
                    {idx < c.interests.length - 1 && " · "}
                  </>
                ))}
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="section" aria-labelledby="exp-h">
    <div class="shell-wide">
      <div class="section-head"><h2 id="exp-h" class="eyebrow">Experience</h2></div>
      <div class="exp-list">
        {
          c.experience.map((e) => (
            <article class="exp-row">
              <p class="meta">{fmtRange(e.data.start, e.data.end)}</p>
              <h3>
                {e.data.title} ·{" "}
                <a href={e.data.companyUrl} rel="noopener">
                  {e.data.company}
                </a>
              </h3>
            </article>
          ))
        }
        <article class="exp-row">
          <p class="meta">
            {c.education.start.slice(0, 4)} — {c.education.end.slice(0, 4)}
          </p>
          <h3>
            MS, {c.education.field} ·{" "}
            <a href={c.education.institutionUrl} rel="noopener">UNC Charlotte</a>
          </h3>
        </article>
      </div>
      <p class="more meta">
        Role details in <a rel="alternate" type="text/markdown" href="/resume.md">/resume.md</a>
      </p>
    </div>
  </section>

  <!-- Selected work -->
  <section class="section section--wash" aria-labelledby="work-h">
    <div class="shell-wide">
      <div class="section-head"><h2 id="work-h" class="eyebrow">Selected work</h2></div>
      <div class="work-grid">
        {
          featured.map((pr) => (
            <a class="work-card" href={pr.data.url} rel="noopener">
              <p class="meta">{pr.data.role}</p>
              <h3>{pr.data.name}</h3>
              <p class="tagline">{pr.data.tagline}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: var(--s16) var(--s12);
  }
  .hero + .section {
    border-top: none;
  }
  .hero-content {
    position: relative;
    z-index: 1;
  }
  .hero-content a,
  .hero-machines {
    pointer-events: auto;
  }
  .hero h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    font-variation-settings: "wdth" 122;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin-block: var(--s4) var(--s6);
    color: var(--ink);
  }
  .headline {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    max-width: 34em;
  }
  .hero-machines {
    margin-top: var(--s8);
    display: inline-flex;
    align-items: baseline;
    gap: var(--s4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--wash) 80%, transparent);
    padding: var(--s3) var(--s4);
  }
  .hero-machines a {
    color: var(--accent-ink);
    text-decoration-color: transparent;
  }
  .hero-machines a:hover {
    text-decoration-color: var(--accent);
  }

  /* compact sections */
  .section {
    padding-block: var(--s12);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(15rem, 2fr);
    gap: var(--s8) var(--s16);
    align-items: start;
  }
  .about-prose {
    max-width: var(--measure);
  }
  .more {
    margin-top: var(--s4);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .more a {
    color: var(--accent-ink);
  }
  .facts {
    border: 1px solid var(--rule);
    background: var(--wash);
    padding: var(--s6);
  }
  .facts-title {
    color: var(--accent-ink);
    margin-bottom: var(--s4);
  }
  .facts dl {
    display: grid;
    gap: var(--s3);
  }
  .facts div {
    display: grid;
    gap: 2px;
    padding-top: var(--s3);
    border-top: 1px solid var(--rule);
  }
  .facts div:first-child {
    border-top: none;
    padding-top: 0;
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-size: var(--text-sm);
  }
  @media (max-width: 56rem) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  .exp-list {
    display: grid;
  }
  .exp-row {
    display: grid;
    grid-template-columns: var(--meta-col) 1fr;
    gap: var(--s2) var(--s6);
    align-items: baseline;
    padding-block: var(--s3);
    border-bottom: 1px solid var(--rule);
  }
  .exp-row:last-child {
    border-bottom: none;
  }
  .exp-row h3 {
    font-size: var(--text-base);
    font-weight: 600;
  }
  @media (max-width: 40rem) {
    .exp-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: var(--s4);
  }
  .work-card {
    display: grid;
    gap: var(--s2);
    align-content: start;
    border: 1px solid var(--rule);
    background: var(--bg);
    padding: var(--s6);
    text-decoration: none;
    transition: border-color 120ms ease;
  }
  .work-card:hover {
    border-color: var(--accent);
  }
  .work-card h3 {
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .work-card:hover h3 {
    color: var(--accent-ink);
  }
  .work-card .tagline {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
</style>
