---
import BaseLayout from "../layouts/BaseLayout.astro";
import KineticGrid from "../components/KineticGrid.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { loadAll, fmtRange } from "../lib/content";

const c = await loadAll();
const p = c.profile;

const logos: Record<string, string> = {
  AMD: "/logos/amd.svg",
  Groq: "/logos/groq.svg",
  Intel: "/logos/intel.svg",
};

const yr = (ym: string) => ym.slice(0, 4);

// One timeline stop per company: consecutive roles at the same place merge,
// latest title leads and earlier titles stack beneath it.
interface Stop {
  logo: string;
  company: string;
  url: string;
  titles: string[];
  start: string;
  end: string | null;
}
const stops: Stop[] = [
  {
    logo: "/logos/uncc.svg",
    company: "UNC Charlotte",
    url: c.education.institutionUrl,
    titles: [`MS, ${c.education.field}`],
    start: c.education.start,
    end: c.education.end,
  },
];
for (const e of c.experience.slice().reverse()) {
  const last = stops[stops.length - 1];
  if (last && last.company === e.data.company) {
    last.titles.unshift(e.data.title);
    last.end = e.data.end;
  } else {
    stops.push({
      logo: logos[e.data.company]!,
      company: e.data.company,
      url: e.data.companyUrl,
      titles: [e.data.title],
      start: e.data.start,
      end: e.data.end,
    });
  }
}
const timeline = stops.map((s) => ({
  ...s,
  dates: s.end ? `${yr(s.start)} – ${yr(s.end).slice(2)}` : `${yr(s.start)} – now`,
  current: !s.end,
}));
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <KineticGrid />
    <div class="shell-wide hero-content">
      <p class="eyebrow">Seattle, WA · On-device AI</p>
      <h1>Ramakrishnan<br />Sivakumar</h1>
      <p class="headline">
        Principal ML Software Engineer at
        <a href="https://www.amd.com" rel="noopener">AMD</a>. I make large language models run
        fast on hardware people already own — as co-creator and maintainer of
        <a href="https://github.com/lemonade-sdk/lemonade" rel="noopener">Lemonade</a>, the
        open-source local AI server (5k+ stars).
      </p>
      <div class="hero-socials">
        <SocialLinks />
      </div>
    </div>
  </section>

  <!-- Current focus -->
  <section class="section section--wash" aria-labelledby="focus-h">
    <div class="shell-wide">
      <div class="section-head"><h2 id="focus-h" class="eyebrow">Current focus</h2></div>
      <div class="work-grid">
        {
          p.focus.map((f) =>
            f.url ? (
              <a class="work-card" href={f.url} rel="noopener">
                <p class="meta">{f.role}</p>
                <h3>{f.title}</h3>
                <p class="tagline">{f.description}</p>
              </a>
            ) : (
              <div class="work-card work-card--static">
                <p class="meta">{f.role}</p>
                <h3>{f.title}</h3>
                <p class="tagline">{f.description}</p>
              </div>
            ),
          )
        }
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="section" aria-labelledby="exp-h">
    <div class="shell-wide">
      <div class="section-head"><h2 id="exp-h" class="eyebrow">Experience</h2></div>
      <ol class="timeline" style={`--stops: ${timeline.length}`}>
        {
          timeline.map((t) => (
            <li class="tl-item">
              <img class="tl-logo" src={t.logo} alt="" loading="lazy" />
              <span class:list={["tl-dot", { "tl-dot--now": t.current }]} aria-hidden="true" />
              <p class="meta tl-dates">{t.dates}</p>
              <h3>{t.titles[0]}</h3>
              {t.titles.length > 1 && <p class="tl-prev">{t.titles.slice(1).join(" · ")}</p>}
              <a class="tl-company" href={t.url} rel="noopener">
                {t.company}
              </a>
            </li>
          ))
        }
      </ol>
      <p class="more meta">
        Role details in <a rel="alternate" type="text/markdown" href="/resume.md">/resume.md</a>
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: var(--s16) var(--s12);
  }
  .hero + .section {
    border-top: none;
  }
  .hero-content {
    position: relative;
    z-index: 1;
  }
  .hero-content a {
    pointer-events: auto;
  }
  .hero h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    font-variation-settings: "wdth" 122;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin-block: var(--s4) var(--s6);
    color: var(--ink);
  }
  .headline {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    max-width: 34em;
  }
  .hero-socials {
    margin-top: var(--s8);
  }

  /* compact sections */
  .section {
    padding-block: var(--s12);
  }


  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--stops, 4), 1fr);
    gap: var(--s6);
    list-style: none;
    padding: var(--s6) 0 var(--s2);
    margin: 0;
  }
  /* the rail: runs through the dots */
  .timeline::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--s6) + 1.5rem + var(--s4) + 5px);
    height: 2px;
    background: var(--rule);
  }
  .tl-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .tl-logo {
    height: 1.5rem;
    width: auto;
    max-width: 5rem;
    object-fit: contain;
    object-position: left center;
    filter: grayscale(1) opacity(0.7);
    transition: filter 120ms ease;
  }
  .tl-item:hover .tl-logo {
    filter: none;
  }
  .tl-dot {
    position: relative;
    z-index: 1;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    outline: 3px solid var(--bg);
    margin-block: var(--s4);
  }
  .tl-dot--now {
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .tl-dates {
    margin-bottom: var(--s2);
  }
  .tl-item h3 {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: var(--leading-normal);
  }
  .tl-prev {
    margin-top: var(--s1);
    font-size: var(--text-xs);
    color: var(--muted);
    line-height: var(--leading-normal);
  }
  .tl-company {
    margin-top: var(--s1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    text-decoration-color: transparent;
  }
  .tl-company:hover {
    color: var(--accent-ink);
  }
  @media (max-width: 48rem) {
    .timeline {
      grid-template-columns: 1fr 1fr;
      gap: var(--s8) var(--s6);
    }
    .timeline::before,
    .tl-dot {
      display: none;
    }
    .tl-logo {
      margin-bottom: var(--s3);
    }
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: var(--s4);
  }
  .work-card {
    display: grid;
    gap: var(--s2);
    align-content: start;
    border: 1px solid var(--rule);
    background: var(--bg);
    padding: var(--s6);
    text-decoration: none;
    transition: border-color 120ms ease;
  }
  .work-card:hover {
    border-color: var(--accent);
  }
  .work-card--static:hover {
    border-color: var(--rule);
  }
  .work-card h3 {
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .work-card:hover h3 {
    color: var(--accent-ink);
  }
  .work-card .tagline {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
</style>
