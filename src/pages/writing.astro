---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadAll } from "../lib/content";

const c = await loadAll();
const bodies = new Map(c.writing.map((w) => [w.id, w.body?.trim() ?? ""]));

const jsonLdExtra = c.writing.map((w) => ({
  "@type": "BlogPosting",
  headline: w.data.title,
  url: w.data.url,
  datePublished: w.data.date.toISOString().slice(0, 10),
  author: { "@id": `${Astro.site?.href}#person` },
  publisher: w.data.venue,
}));
---

<BaseLayout
  title="Writing"
  description="Articles by Ramakrishnan Sivakumar on ONNX, ML compilers, local LLM inference, open source, and AI accelerators."
  jsonLdExtra={jsonLdExtra}
>
  <div class="shell-wide">
    <header class="page-head">
      <h1>Writing</h1>
      <p class="lede prose">
        Articles on ML systems: ONNX, compilers, local inference, and occasionally products,
        ecosystems, and whatever else earns an essay.
      </p>
    </header>
    <div class="card-grid">
      {
        c.writing.map((w) => (
          <a class="card" href={w.data.url} rel="noopener">
            <p class="meta">
              {w.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", timeZone: "UTC" })}
              &nbsp;·&nbsp;{w.data.venue}
            </p>
            <h2>{w.data.title}</h2>
            <p class="summary">{bodies.get(w.id)}</p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--s16) var(--s12);
  }
  h1 {
    font-size: var(--text-2xl);
    font-variation-settings: "wdth" 118;
    text-transform: uppercase;
  }
  .lede {
    margin-top: var(--s3);
    color: var(--muted);
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
    gap: var(--s4);
    padding-bottom: var(--s16);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    aspect-ratio: 1 / 1;
    padding: var(--s6);
    border: 1px solid var(--rule);
    background: #fff;
    text-decoration: none;
    transition: border-color 120ms ease, background 120ms ease;
    overflow: hidden;
  }
  .card:hover {
    border-color: var(--accent);
    background: var(--wash);
  }
  .card h2 {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-tight);
  }
  .card:hover h2 {
    color: var(--accent-ink);
  }
  .summary {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 40rem) {
    .card {
      aspect-ratio: auto;
    }
  }
</style>
