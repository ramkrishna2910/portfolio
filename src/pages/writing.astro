---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadAll } from "../lib/content";
import { cloud } from "../lib/writingCloud";
import { buildCloudSvg } from "../lib/wordCloudSvg";

const cloudSvg = buildCloudSvg();

const c = await loadAll();
const bodies = new Map(c.writing.map((w) => [w.id, w.body?.trim() ?? ""]));
const featured = c.writing.filter((w) => w.data.featured);
const rest = c.writing.filter((w) => !w.data.featured);
const ordered = [...featured, ...rest];

const jsonLdExtra = c.writing.map((w) => ({
  "@type": "BlogPosting",
  headline: w.data.title,
  url: w.data.url,
  datePublished: w.data.date.toISOString().slice(0, 10),
  author: { "@id": `${Astro.site?.href}#person` },
  publisher: w.data.venue,
}));

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", timeZone: "UTC" });
---

<BaseLayout
  title="Writing"
  description="Articles by Ramakrishnan Sivakumar on ONNX, ML compilers, local LLM inference, open source, and AI accelerators."
  jsonLdExtra={jsonLdExtra}
>
  <div class="shell-wide">
    <header class="page-head">
      <h1 class="sr-only">Writing</h1>
      <div class="cloud-hero" set:html={cloudSvg} />
      <ul class="sr-only">
        {cloud.map((word) => <li>{word.t}</li>)}
      </ul>
    </header>

    <div class="card-grid">
      {
        ordered.map((w, i) => (
          <a
            class:list={["card", `tint-${i % 6}`, { "card--featured": w.data.featured }]}
            href={w.data.url}
            rel="noopener"
          >
            <p class="meta eyebrow-line">{w.data.venue}</p>
            <h2>{w.data.title}</h2>
            <p class="summary">{bodies.get(w.id)}</p>
            <p class="read-more">
              <span>Read more</span>
              <span aria-hidden="true">&nbsp;&#8594;</span>
              <span class="date">{fmt(w.data.date)}</span>
            </p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--s16) var(--s12);
  }
  h1 {
    font-size: var(--text-2xl);
    font-variation-settings: "wdth" 118;
    text-transform: uppercase;
  }

  /* packed word-cloud hero: sized by real term frequency across the articles */
  .cloud-hero {
    max-width: 56rem;
    margin-inline: auto;
  }
  .cloud-hero :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-flow: dense;
    gap: var(--s5);
    padding-bottom: var(--s16);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    padding: var(--s6);
    text-decoration: none;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  .card--featured {
    grid-column: span 2;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(26, 28, 30, 0.08);
  }
  .tint-0 { background: #fbf3d7; }
  .tint-1 { background: #f9e9e2; }
  .tint-2 { background: #e9f2e3; }
  .tint-3 { background: #e7eef6; }
  .tint-4 { background: #efeaf6; }
  .tint-5 { background: #f3eee1; }

  .eyebrow-line {
    color: var(--accent-ink);
  }
  .card h2 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-tight);
  }
  .card--featured h2 {
    font-size: var(--text-xl);
  }
  .summary {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card--featured .summary {
    -webkit-line-clamp: 4;
  }
  .read-more {
    margin-top: auto;
    padding-top: var(--s3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
    display: flex;
    align-items: baseline;
  }
  .card:hover .read-more {
    color: var(--accent-ink);
  }
  .read-more .date {
    margin-left: auto;
    color: var(--faint);
  }
  @media (max-width: 60rem) {
    .card-grid {
      grid-template-columns: 1fr 1fr;
    }
    .card--featured {
      grid-column: span 2;
    }
  }
  @media (max-width: 40rem) {
    .card-grid {
      grid-template-columns: 1fr;
    }
    .card--featured {
      grid-column: span 1;
    }
  }
</style>
