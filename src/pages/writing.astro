---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadAll } from "../lib/content";
import { gridArt } from "../lib/gridArt";

const c = await loadAll();
const bodies = new Map(c.writing.map((w) => [w.id, w.body?.trim() ?? ""]));
const featured = c.writing.filter((w) => w.data.featured);
const rest = c.writing.filter((w) => !w.data.featured);

const jsonLdExtra = c.writing.map((w) => ({
  "@type": "BlogPosting",
  headline: w.data.title,
  url: w.data.url,
  datePublished: w.data.date.toISOString().slice(0, 10),
  author: { "@id": `${Astro.site?.href}#person` },
  publisher: w.data.venue,
}));

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", timeZone: "UTC" });
---

<BaseLayout
  title="Writing"
  description="Articles by Ramakrishnan Sivakumar on ONNX, ML compilers, local LLM inference, open source, and AI accelerators."
  jsonLdExtra={jsonLdExtra}
>
  <div class="shell-wide">
    <header class="page-head">
      <h1>Writing</h1>
      <p class="lede prose">
        Articles on ML systems: ONNX, compilers, local inference, and occasionally products,
        ecosystems, and whatever else earns an essay.
      </p>
    </header>

    <div class="card-grid">
      {
        [...featured, ...rest].map((w) => (
          <a
            class:list={["card", { "card--featured": w.data.featured }]}
            href={w.data.url}
            rel="noopener"
          >
            <div class="card-art" set:html={gridArt(w.data.title, w.data.featured ? 880 : 640, 260)} />
            <div class="card-body">
              <p class="meta">
                {fmt(w.data.date)}&nbsp;·&nbsp;{w.data.venue}
              </p>
              <h2>{w.data.title}</h2>
              <p class="summary">{bodies.get(w.id)}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--s16) var(--s12);
  }
  h1 {
    font-size: var(--text-2xl);
    font-variation-settings: "wdth" 118;
    text-transform: uppercase;
  }
  .lede {
    margin-top: var(--s3);
    color: var(--muted);
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--s4);
    padding-bottom: var(--s16);
  }
  .card {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    background: #fff;
    text-decoration: none;
    transition: border-color 120ms ease;
    overflow: hidden;
  }
  .card--featured {
    grid-column: span 3;
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card-art {
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
    aspect-ratio: 640 / 260;
  }
  .card--featured .card-art {
    aspect-ratio: 880 / 260;
  }
  .card-art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    padding: var(--s5) var(--s6) var(--s6);
  }
  .card h2 {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-tight);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card--featured h2 {
    font-size: var(--text-xl);
  }
  .card:hover h2 {
    color: var(--accent-ink);
  }
  .summary {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 60rem) {
    .card,
    .card--featured {
      grid-column: span 3;
    }
  }
  @media (max-width: 40rem) {
    .card,
    .card--featured {
      grid-column: span 6;
    }
  }
</style>
