---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<button class="yt-lite" data-yt-id={id} aria-label={`Play video: ${title}`}>
  <img src={thumb} alt="" loading="lazy" width="480" height="360" />
  <span class="play" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
      <path d="M8 5v14l11-7z"></path>
    </svg>
  </span>
</button>

<script>
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest?.(".yt-lite") as HTMLElement | null;
    if (!btn) return;
    const id = btn.dataset.ytId;
    const iframe = document.createElement("iframe");
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
    iframe.title = btn.getAttribute("aria-label") ?? "Video";
    iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
    iframe.allowFullscreen = true;
    iframe.className = "yt-frame";
    btn.replaceWith(iframe);
  });
</script>

<style>
  .yt-lite {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 1px solid var(--rule);
    background: var(--ink);
    cursor: pointer;
    overflow: hidden;
  }
  .yt-lite img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.92;
    transition: opacity 120ms ease;
  }
  .yt-lite:hover img {
    opacity: 1;
  }
  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .play svg {
    box-sizing: content-box;
    padding: 0.7rem 0.9rem;
    background: var(--bg);
    color: var(--accent-ink);
    border-radius: 999px;
    border: 1px solid var(--rule);
  }
  .yt-lite:hover .play svg {
    color: var(--accent);
  }
</style>

<style is:global>
  .yt-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule);
  }
</style>
