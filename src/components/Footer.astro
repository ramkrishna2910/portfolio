---
import { getCollection } from "astro:content";

const [profileEntry] = await getCollection("profile");
const p = profileEntry.data;
const year = new Date().getFullYear();
---

<footer class="site-footer band-deep">
  <div class="shell-wide inner">
    <div class="contact">
      <p class="meta">Contact</p>
      <ul>
        <li><a href={`mailto:${p.email}`}>{p.email}</a></li>
        {p.socials.map((s) => (
          <li>
            <a href={s.url} rel="me">{s.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="machines">
      <p class="meta">For machines</p>
      <ul>
        <li>
          <a rel="alternate" type="text/markdown" href="/resume.md">GET /resume.md</a>
        </li>
        <li><a href="/llms.txt">GET /llms.txt</a></li>
        <li><span>schema.org/Person&nbsp;&#10003;</span></li>
      </ul>
    </div>
    <p class="colophon">
      &copy; {year} {p.name}. Hand-built, statically generated, readable by humans and agents alike.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 4px solid var(--deep-edge);
    margin-top: var(--s24);
    padding-block: var(--s12);
  }
  .inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s8);
  }
  ul {
    list-style: none;
    padding: 0;
    margin-top: var(--s3);
    display: grid;
    gap: var(--s1);
  }
  .contact a {
    font-size: var(--text-sm);
  }
  .machines {
    font-family: var(--font-mono);
  }
  .machines a,
  .machines span {
    font-size: var(--text-sm);
  }
  .colophon {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    color: var(--muted-on-deep);
    border-top: 1px solid var(--grid-on-deep);
    padding-top: var(--s6);
  }
  @media (max-width: 40rem) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
