---
import { getCollection } from "astro:content";

const [profileEntry] = await getCollection("profile");
const p = profileEntry.data;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell-wide inner">
    <p class="machines">
      <span class="meta">For machines&nbsp;→</span>
      <a rel="alternate" type="text/markdown" href="/resume.md">GET /resume.md</a>
      <a href="/llms.txt">GET /llms.txt</a>
      <span>schema.org/Person&nbsp;&#10003;</span>
    </p>
    <p class="colophon">
      &copy; {year} {p.name}. Hand-built, statically generated, readable by humans and agents alike.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: var(--s16);
    padding-block: var(--s8);
    background: #fff;
  }
  .inner {
    display: grid;
    gap: var(--s4);
  }
  .machines {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s6);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .machines a,
  .machines span:not(.meta) {
    color: var(--accent-ink);
  }
  .colophon {
    font-size: var(--text-sm);
    color: var(--muted);
  }
</style>
