---
const links = [
  { href: "/", label: "Home" },
  { href: "/writing", label: "Writing" },
  { href: "/talks", label: "Talks" },
  { href: "/research", label: "Research" },
  { href: "/highlights", label: "Highlights" },
  { href: "/resume.md", label: "Resume", external: true },
];
const current = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
---

<header class="site-header">
  <nav class="shell-wide" aria-label="Site">
    <a class="brand" href="/">RS</a>
    <ul>
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={current === l.href ? "page" : undefined}
              {...(l.external ? { "data-external": "" } : {})}
            >
              {l.label}
              {l.external && <span aria-hidden="true">&nbsp;&#8599;</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--s4);
    gap: var(--s6);
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-variation-settings: "wdth" 125;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--accent-ink);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s6);
    list-style: none;
    padding: 0;
  }
  ul a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--muted);
  }
  ul a:hover {
    color: var(--accent-ink);
  }
  ul a[aria-current="page"] {
    color: var(--ink);
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
  }
  @media (max-width: 40rem) {
    nav {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s3);
    }
  }
</style>
